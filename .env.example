# ==============================================================================
# WRFCoin Backend Environment Variables
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.
# ==============================================================================

# --- Core ---
NODE_ENV=development
PORT=5002

# --- Database ---
# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/wrfcoin
# Required by bootstrap/orchestration paths. Keep aligned with DATABASE_URL.
POSTGRES_PASSWORD=<generate-with-openssl-rand-hex-32>
# Required: Redis connection string
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# Required: JWT signing secret (generate a strong random value with: openssl rand -hex 64)
JWT_SECRET=<generate-with-openssl-rand-hex-64>
# Required by testnet api-gateway service-to-service auth (generate with: openssl rand -hex 32)
SERVICE_TOKEN=<generate-with-openssl-rand-hex-32>
# Required: refresh-token signing secret (generate with: openssl rand -hex 64)
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-64>
# Required in production: Express/session signing secret (generate with: openssl rand -hex 64)
SESSION_SECRET=<generate-with-openssl-rand-hex-64>

# Required for protected RPC and node-control routes. Generate each with:
# openssl rand -hex 32
RPC_API_KEY=<generate-with-openssl-rand-hex-32>
ADMIN_TOKEN=<generate-with-openssl-rand-hex-32>

# Required in production/testnet: OAuth state HMAC secret (CSRF protection for
# OAuth login flows). Backend falls back to an insecure dev value only in
# non-production environments. Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=<generate-with-openssl-rand-hex-32>

# --- Encryption ---
# Required: encryption key for application data (generate with: openssl rand -hex 32)
# Server will refuse to start without this.
ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# --- API Key Encryption ---
# Required: encryption key for stored API keys (generate with: openssl rand -hex 32)
# Server will refuse to start without this.
API_KEY_ENCRYPTION_KEY=<generate-with-openssl-rand-hex-32>

# Max weather stations one wallet may register (#589). Non-integer/negative
# values fall back to the default (10) — never to unlimited. 0 freezes
# self-service registration.
MAX_STATIONS_PER_OWNER=10

# --- Blockchain (core4 API) ---
WRFCOIN_API_HOST=127.0.0.1
WRFCOIN_API_PORT=8556
# Local/bare-metal default. The 127.0.0.1 value is correct ONLY when the backend
# and the core4 node share a host/network namespace.
# #753: in Docker/testnet, `localhost`/`127.0.0.1` resolves to the backend's OWN
# container, not the node — health/readiness probes will see core4 as down.
# Set this to the container-reachable node address, e.g. http://wrfcoin-node:8556
# (this is what docker-compose.testnet.yml defaults to).
CORE4_API_URL=http://127.0.0.1:8556
# Operator token for core4 API — grants ApiRole::Operator (governance, bridge halt, privileged endpoints)
# Generate: openssl rand -hex 32
# CRITICAL: Never commit real values. Rotate immediately if exposed.
WRFCOIN_OPERATOR_TOKEN=
# Default contributor address for weather data submissions
WRFCOIN_CONTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000b02

# #932 staged submit auth: 'off' (default — accept + warn on anonymous submits)
# or 'enforce' (require the station submit token or WRFCOIN_CONTRIBUTOR_TOKEN;
# no anonymous fallback). Flip to enforce ONLY after every live collector
# carries a token — see drizzle/manual/932-station-submit-tokens.sql.
# A typo here runs as 'off' and logs an error on every submit until fixed.
WEATHER_SUBMIT_AUTH_MODE=off
# Legacy aliases (deprecated — use CORE4_API_URL): BLOCKCHAIN_NODE_URL, BLOCKCHAIN_SERVICE_URL, RUST_BLOCKCHAIN_URL
NETWORK_ID=testnet

# --- Public balance read for the passkey wallet (GET /api/public/balance/:address) ---
# Default OFF (404). Enablement checklist:
#   1. WRFCOIN_READER_TOKEN is set (the route reads core4 with it; without it the route answers 503).
#   2. TRUSTED_PROXIES lists the real reverse proxy in front of this backend. The 30/min per-client
#      limit takes the client from X-Forwarded-For only through a trusted proxy; if the proxy is
#      missing, every client shares the proxy's single bucket (fails closed, but throttles everyone).
#   3. Optional: PUBLIC_BALANCE_UPSTREAM_MAX_PER_MIN caps this route's account reads to core4 for the
#      whole process (default 120, at most 500), well under core4's 1000/min Reader budget that all
#      backend reads share. Past the cap the route answers 503 with Retry-After.
PUBLIC_BALANCE_READ_ENABLED=false
PUBLIC_BALANCE_UPSTREAM_MAX_PER_MIN=120

# --- Public proof card for one station reading (GET /api/proofs/:commitId[?h=<height>], backend#229) ---
# Default OFF (404). Every field is read from the node with WRFCOIN_READER_TOKEN (503 without it).
# TRUSTED_PROXIES must list the real reverse proxy (30/min per client, same limiter as the balance read).
# PROOF_CARDS_UPSTREAM_MAX_PER_MIN caps card loads for the whole process (default 30, at most 120);
# one load is at most 6 node reads. Past the cap the route answers 503 with Retry-After.
PROOF_CARDS_ENABLED=false
PROOF_CARDS_UPSTREAM_MAX_PER_MIN=30
# --- Forecasts checked against station readings (GET/POST /api/forecast-verification, backend PR#72/#1494) ---
# Default OFF (404, job not started). Needs migration 0039_forecast_verification (applied by hand: the
# backend does not run migrations at startup), WRFCOIN_READER_TOKEN and TRUSTED_PROXIES.
# The job scores handed-in forecast records against the chain's readings every 5 min and, once an hour,
# captures NOAA's hourly forecast for the stations forecasters target (set NOAA_REFERENCE=false to skip).
FORECAST_VERIFICATION_ENABLED=false
FORECAST_VERIFICATION_NOAA_REFERENCE=true
# FORECAST_VERIFICATION_INTERVAL_MS=300000
# FORECAST_VERIFICATION_GIVE_UP_HOURS=12
# --- Friend challenges (/api/challenges, backend#249; phone screen mobile#260) ---
# Default OFF (404, counting job not started). Needs migration 0040_friend_challenges (applied by hand:
# the backend does not run migrations at startup), WRFCOIN_READER_TOKEN, JWT_SECRET and TRUSTED_PROXIES.
# Points only. Counts come from chain readings of the stations each wallet owns.
FRIEND_CHALLENGES_ENABLED=false
# FRIEND_CHALLENGES_INTERVAL_MS=120000
# --- Free-play forecast duels (/api/duels, backend#228/#1424) ---
# Default OFF (404, resolver not started). NO stakes: the chain's finalized forecast rewards judge.
# Needs migration 0041_forecast_duels (applied by hand: the backend does not run migrations at startup),
# WRFCOIN_READER_TOKEN, JWT_SECRET and TRUSTED_PROXIES.
FORECAST_DUELS_ENABLED=false
# FORECAST_DUELS_INTERVAL_MS=300000

# --- Public producers and bonded nodes read (GET /api/network/nodes) ---
# Default OFF (404). Reads the node with WRFCOIN_READER_TOKEN (503 without it); one snapshot per 60 s for
# everyone, 30/min per client (TRUSTED_PROXIES must list the real reverse proxy).
# core4 has no route that lists bonds: bonds are found in recent node-settlement epochs plus this list
# of known deployment ids (64 hex each, comma separated); every id is checked on chain before it shows.
NETWORK_NODES_READ_ENABLED=false
NETWORK_NODES_BOND_IDS=

# --- Weekly forecast competition (GET /api/competitions, backend#251) ---
# Default OFF (503). Needs CHAIN_REWARD_INDEX_ENABLED=true (it reads the same forecast index as
# /api/forecasters) and migration 0036_forecast_competitions applied BEFORE this is turned on.
FORECAST_COMPETITIONS_ENABLED=false

# --- Payout notifications (/api/notifications, backend#389) ---
# Default OFF (503). No email or personal data: subscriptions are an address plus a browser push
# subscription or an ntfy topic, created with the wallet login of that address. Enablement:
#   1. Apply migration 0037_payout_notifications.
#   2. WRFCOIN_READER_TOKEN is set (the watcher reads earned_balance_total from core4 with it).
#   3. Web Push: generate a VAPID key pair once (`npx web-push generate-vapid-keys`) and set both keys;
#      the subject is a URL, not an email. Without them only ntfy is offered.
#   4. ntfy: posts to PAYOUT_NOTIFY_NTFY_SERVER (default https://ntfy.sh, free); `off` disables it.
PAYOUT_NOTIFY_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=https://wrfcoin.com
PAYOUT_NOTIFY_NTFY_SERVER=https://ntfy.sh
# Optional: link target in notifications, pass interval (min 60000 ms) and addresses read per pass.
PAYOUT_NOTIFY_SITE_URL=https://wrfcoin.com
PAYOUT_NOTIFY_INTERVAL_MS=300000
PAYOUT_NOTIFY_MAX_ADDRESSES=200

# --- Station calibration certificates (/api/calibration-certificates, core4#388/#435, #931) ---
# Default OFF (404). Needs migration 0038_calibration_certificates applied by hand first (CT101's
# backend does not run migrations at startup). See docs/calibration-attestation-verifier.md.
CALIBRATION_CERTIFICATES_ENABLED=false
# Trust roots = who may sign certificates. JSON array; pin each root by its raw ed25519 public key:
#   [{"rootId":"wrfcoin-owner-testnet","subject":"WRFCoin owner (testnet)","publicKeyHex":"<64 hex>","active":true}]
# `npx tsx scripts/calibration-certificate.ts keygen` prints this entry for a new key. Placeholder:
# the owner-held testnet key (owner decision pending; never commit a private key, the public key only).
# A legacy entry may pin `fingerprintSha256` (sha256 of the raw public key) instead of publicKeyHex.
# v1 trust model: depth-1 chains only; the signer key IS the root.
# Unset => every certificate rejects with CAL_TRUST_ROOT_UNCONFIGURED (fail closed).
CALIBRATION_TRUST_ROOTS_JSON=
# Optional revocations: JSON array or CSV of cert sha256 fingerprints.
CALIBRATION_REVOKED_CERTIFICATES_JSON=

# --- Oracle-reference shadow scoring (advisory only) ---
# Enable only when the oracle-reference sidecar is reachable. Failures never
# change reveal acceptance or rewards; successful scores persist for analysis.
REFERENCE_SHADOW=0
# Mirror core4 reward_gross_outlier_guard activation height; empty = unscheduled.
# Update alongside the chain feature schedule, including governance extensions.
REFERENCE_GROSS_GUARD_ACTIVATION_HEIGHT=
ORACLE_REFERENCE_URL=http://oracle-reference:8010
ORACLE_REFERENCE_TIMEOUT_MS=5000

# --- HSM / Vault (optional in dev) ---
VAULT_ENDPOINT=http://localhost:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=
HSM_ENDPOINT=
HSM_KEY_ID=

# --- Oracle Bridge ---
# Path to the Rust oracle-bridge binary (defaults to core4/target/release/oracle-bridge)
ORACLE_BRIDGE_BINARY_PATH=
ORACLE_WS_HOST=localhost

# --- WebSocket ---
WS_PORT=5001
WS_MAX_CONNECTIONS_PER_MINUTE=60
WS_MAX_MESSAGES_PER_MINUTE=100
# Disconnect a slow WebSocket before its process-local send buffer grows without
# bound. Defaults to 1 MiB.
WS_MAX_BUFFERED_BYTES=1048576

# --- Experimental ZK privacy ---
# Keep disabled until a versioned production verifier is integrated.
ZK_PRIVACY_ENABLED=false
# Test/development only. This never verifies a proof and does not bypass the
# ZK_PRIVACY_ENABLED gate.
ZK_STUB_MODE=false

# --- External AI APIs (optional) ---
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
XAI_API_KEY=

# --- SMS Observation Gateway ---
# HMAC shared secret used to verify inbound SMS observation envelopes (signature
# auth, not JWT). REQUIRED outside development — the gateway fails closed and the
# main API will not start without it. Never reuse across environments.
# Generate: openssl rand -hex 32
SMS_OBSERVATION_GATEWAY_SECRET=

# --- IoT Sensors (optional) ---
ACURITE_LOCAL_IP=
ACURITE_DEVICE_ID=
MYACURITE_EMAIL=
MYACURITE_PASSWORD=
AMBIENT_WEATHER_API_KEY=
AMBIENT_WEATHER_APP_KEY=

# --- Social Authentication ---
SOCIAL_AUTH_TEST_MODE=true

# --- CORS ---
CORS_ORIGIN=http://localhost:3000
CORS_NON_BROWSER_ORIGIN=

# --- AI/ML Ensemble ---
AIML_ENSEMBLE_HALFLIFE_DAYS=14
AIML_ENSEMBLE_RETIREMENT_THRESHOLD=0.35
AIML_ENSEMBLE_RETIREMENT_ROUNDS=3

# --- Cross-Chain Bridges (optional) ---
BRIDGE_VALIDATORS=
WORMHOLE_RPC_URL=
# Required before enabling the Wormhole bridge service.
WORMHOLE_EVM_RPC_URL=
WORMHOLE_SOLANA_RPC_URL=
WORMHOLE_GUARDIAN_RPC=

# --- Services ---
SERVICE_HOST=localhost
N8N_URL=
N8N_API_KEY=

# --- SSL (production only) ---
SSL_KEY=
SSL_CERT=

# --- OpenTelemetry / Observability (optional) ---
# Set to 'false' to disable OpenTelemetry tracing and metrics entirely.
# Default is enabled (true), but exporters will fail silently without a collector.
OTEL_ENABLED=false
# Service name tag attached to all traces and metrics
OTEL_SERVICE_NAME=wrfcoin-backend
# OTLP HTTP endpoint for trace export (Jaeger, Grafana Tempo, etc.)
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
# OTLP HTTP endpoint for metric export
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://jaeger:4318/v1/metrics
# Port for the Prometheus /metrics scrape endpoint exposed by the backend
PROMETHEUS_METRICS_PORT=9464
# Set to 'true' to enable verbose OTel diagnostic logging (noisy — dev only)
OTEL_DEBUG=false

# --- Logging ---
# Console logging (enabled by default; set to "false" to suppress in production)
# ENABLE_CONSOLE_LOGS=true
LOG_LEVEL=info

# --- Monitoring (optional) ---
SENTRY_DSN=

# --- Slack Integration (Claude-in-Slack Bridge) ---
# Webhook URL for outbound alerts to Slack
SLACK_WEBHOOK_URL=
# Enable/disable Slack notifications (defaults to true if webhook URL is set)
SLACK_ENABLED=true
# Slack app signing secret for verifying inbound requests
# Required on testnet/production for slash commands and events. Generate with: openssl rand -hex 32
SLACK_SIGNING_SECRET=<generate-with-openssl-rand-hex-32>
# Bot token for API calls (optional, for advanced features)
SLACK_BOT_TOKEN=
# Channel mappings for alert severity routing
SLACK_CHANNEL_CRITICAL=#wrfcoin-alerts-critical
SLACK_CHANNEL_WARNING=#wrfcoin-alerts-warnings
SLACK_CHANNEL_INFO=#wrfcoin-alerts
SLACK_CHANNEL_TESTS=#wrfcoin-alerts
SLACK_CHANNEL_HEALTH=#wrfcoin-infrastructure

# --- AlertManager Webhook ---
# Port for AlertManager webhook handler
ALERTMANAGER_WEBHOOK_PORT=19093
# Shared secret for authenticating AlertManager requests
# Required on testnet/production; server returns 503 without this. Generate with: openssl rand -hex 32
ALERTMANAGER_WEBHOOK_SECRET=<generate-with-openssl-rand-hex-32>

# --- OpenForis (optional) ---
OPENFORIS_API_KEY=
OPENFORIS_TEST_MODE=true
# Required when OpenForis routes run outside development.
OPENFORIS_JWT_SECRET=<generate-with-openssl-rand-hex-64>
# Optional API-key auth config; JSON array, kept empty by default.
OPENFORIS_API_KEYS=
