{
  "name": "@wrfcoin/generated-types",
  "version": "0.1.0",
  "description": "Auto-generated shared TypeScript bindings from WRFCoin Rust crates (meteo-types, forecast-score)",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wrfcoin/backend.git",
    "directory": "shared/generated-types"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
