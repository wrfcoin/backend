{
  "name": "@wrfcoin/backend",
  "version": "1.0.0",
  "license": "MIT OR Apache-2.0",
  "description": "Backend services for WRFCoin platform",
  "engines": {
    "node": "^24.15.0"
  },
  "type": "module",
  "main": "index.js",
  "bin": {
    "wrfcoin-grib-extract": "./scripts/wrfcoin-grib-extract.mjs"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-build-assets.mjs && node scripts/verify-dist-import-resolution.mjs && node scripts/verify-station-service-runtime-layout.mjs && node scripts/verify-documentation-build-assets.mjs",
    "verify:station-service-runtime-layout": "node scripts/verify-station-service-runtime-layout.mjs",
    "audit:safe-mount-build": "node scripts/audit-safe-mount-build.mjs --assert",
    "test:sensor-safe-mount-build": "node scripts/test-sensor-safe-mount-build.mjs",
    "verify:station-reward-progress-build": "node scripts/verify-station-reward-progress-build.mjs",
    "dev": "tsx server/enhanced_unified_api_optimized.ts",
    "dev:iot-gateway": "tsx server/iot-edge-gateway/gateway.ts",
    "dev:rtl433-ingestion": "tsx server/rtl433_ingestion_server.ts",
    "start": "node dist/server/enhanced_unified_api_optimized.js",
    "start:main-api": "node dist/server/enhanced_unified_api_optimized.js",
    "start:iot-gateway": "tsx server/iot-edge-gateway/gateway.ts",
    "start:rtl433-ingestion": "tsx server/rtl433_ingestion_server.ts",
    "test": "node scripts/jest-with-leak-guard.cjs --config __tests__/jest.standalone.cjs",
    "test:watch": "jest --config __tests__/jest.standalone.cjs --watch",
    "test:coverage": "jest --config __tests__/jest.standalone.cjs --coverage",
    "hygiene:check-untracked": "node scripts/check-untracked-sources.cjs",
    "hygiene:pre-deploy": "bash scripts/pre-deploy-cleanup.sh",
    "hygiene:pre-deploy-fix": "bash scripts/pre-deploy-cleanup.sh --fix",
    "docs:check-service-registry": "node scripts/check-server-service-registry.mjs",
    "security:check-openforis-demo": "node scripts/check-openforis-demo-credentials.cjs",
    "lint": "eslint '**/*.{js,jsx,ts,tsx}' --ignore-pattern 'node_modules/**' --ignore-pattern 'dist/**'",
    "lint:fix": "eslint '**/*.{js,jsx,ts,tsx}' --ignore-pattern 'node_modules/**' --ignore-pattern 'dist/**' --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:startup": "tsx scripts/run-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "prepare": "[ -d .git ] && husky || true",
    "test:quarantined": "RUN_QUARANTINED=1 WRFCOIN_TEST_POW_DIFFICULTY=4 jest --config __tests__/jest.standalone.cjs"
  },
